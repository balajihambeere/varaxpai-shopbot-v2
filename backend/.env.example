# Copy to .env and adjust. Nothing here is a real secret.

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Cache / session store ---
REDIS_URL=redis://localhost:6379/0

# --- Rerank service ---
RERANK_URL=http://localhost:8001/rerank
RERANK_TIMEOUT_SECONDS=2.0

# --- LLM provider ---
# Leave OPENAI_API_KEY empty to use the deterministic mock provider (no network,
# no cost). Set it to switch to the real OpenAI chat-completions API automatically
# — no separate provider flag needed.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Embedding provider ---
# Deliberately NOT OpenAI — retrieval embeddings stay on the free local model.
# Swapping this to a hosted embedding API would require re-ingesting the whole
# catalog (vector spaces aren't compatible across models) and recalibrating
# CONFIDENCE_FLOOR / SEMANTIC_CACHE_THRESHOLD, since score distributions change.
# "fastembed_local" runs fully offline after first model download, no API key needed.
EMBEDDING_PROVIDER=fastembed_local
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
RERANK_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
HYBRID_FETCH_K=20
RRF_K=60
RERANK_TOP_K=3
CONFIDENCE_FLOOR=-8.5

# --- Cache tuning ---
EXACT_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.97

# --- Memory tuning ---
SESSION_TTL_SECONDS=86400
RECENT_TURNS_WINDOW=3
SUMMARY_REFRESH_EVERY_N_TURNS=4
ACTIVE_ENTITY_LIMIT=3
ACTIVE_ENTITY_BOOST=0.05

# --- Catalog / admin ---
CATALOG_ADMIN_TOKEN=change-me-local-dev-only

# --- Observability ---
LOG_LEVEL=INFO
